[Unit]
Description=bopOS device
Wants=network-online.target
After=network-online.target sound.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/bopOS
Environment=HOME=/home/pi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/locale
ExecStart=/home/pi/bopOS/bash/start.sh
ExecStop=/home/pi/bopOS/bash/stop.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s
TimeoutStartSec=0
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
