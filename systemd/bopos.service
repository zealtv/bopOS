[Unit]
Description=bopOS node daemon
PartOf=bopos.target
After=network-online.target
StartLimitIntervalSec=0
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/bopOS
Environment=HOME=/home/pi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/locale
Slice=system.slice
KillMode=control-group
ExecStart=/home/pi/bopOS/bash/run/service.sh daemon
Restart=always
RestartSec=2s
