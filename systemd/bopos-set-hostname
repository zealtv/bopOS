#!/bin/bash
set -euo pipefail

hostname_re='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
if [ "$#" -ne 1 ] || [[ ! "$1" =~ $hostname_re ]]; then
    echo "ERROR: hostname must be 1-63 lowercase letters, digits, or internal hyphens" >&2
    exit 2
fi

hostname="$1"
/usr/bin/hostnamectl set-hostname "$hostname"
/usr/bin/sed -i "s/^127\.0\.1\.1.*/127.0.1.1   $hostname/" /etc/hosts
/usr/bin/systemctl try-restart avahi-daemon.service >/dev/null 2>&1 || true
