[Unit]
Description=bopOS framework service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bopOS
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/venv/bin/python /home/pi/bopOS/python/helper.py
Restart=always
RestartSec=250ms

[Install]
WantedBy=multi-user.target
