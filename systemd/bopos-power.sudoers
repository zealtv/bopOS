# bopOS narrow privileged controls; installed as /etc/sudoers.d/bopos-power
pi ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/local/sbin/bopos-set-hostname *, /usr/local/sbin/bopos-set-wifi "", /usr/local/sbin/bopos-set-wifi --status, /usr/bin/systemctl start bopos-engine.service, /usr/bin/systemctl stop bopos-engine.service, /usr/bin/systemctl restart bopos-engine.service, /usr/bin/systemctl --no-block restart bopos-engine.service
